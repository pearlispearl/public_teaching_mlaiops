{
  "displayName": "ITCS355 feature drift (PSI > 0.10)",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "PSI temp_c > 0.10",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/itcs355/drift.psi.temp_c\" resource.type=\"global\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.1,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "PSI vibration_mm_s > 0.10",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/itcs355/drift.psi.vibration_mm_s\" resource.type=\"global\"",
