# Lab 3 serve image + boto3 + the real AWS adapter (the base image still has the Lab 1 stub)
# + AWS Lambda Web Adapter, so the unmodified web service runs on Lambda.
ARG BASE
FROM ${BASE}
USER root
RUN pip install --no-cache-dir "boto3>=1.34"
COPY cloudlayer/aws.py /app/cloudlayer/aws.py
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
USER runner
